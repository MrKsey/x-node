[Unit]
Description=X-Node — root helper for the web interface
Documentation=file:/usr/local/share/doc/x-node/README.md
After=network.target

[Service]
Type=simple
User=root
Group=x-node
# The helper only exists for the two root operations the dashboard offers:
# restarting x-node or yggdrasil, and writing /etc/x-node/config.json or
# /etc/yggdrasil/yggdrasil.conf. It listens on a unix socket that the x-node
# group can open, and it validates every request before acting.
ExecStart=/usr/local/bin/x-node helper serve
Restart=on-failure
RestartSec=5s
RuntimeDirectory=x-node
RuntimeDirectoryMode=0750
UMask=0077

# Root is required for systemctl and for writing under /etc, so the unit keeps
# the rest of the system out of reach instead.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
