[Unit]
Description=X-Node — Yggdrasil exit node
Documentation=file:/usr/local/share/doc/x-node/README.md
After=network-online.target yggdrasil.service
Wants=network-online.target yggdrasil.service
# x-node listens on the Yggdrasil address, so it starts after yggdrasil. It
# deliberately does not use Requires= or PartOf=: those made systemd stop
# x-node whenever yggdrasil stopped or restarted (the dashboard's "Restart
# yggdrasil" button included), and nothing started it again when yggdrasil came
# back. The daemon waits for the address instead, keeps the web interface
# reachable while yggdrasil is down, and its listening socket works again as
# soon as the address returns.

[Service]
Type=simple
User=x-node
Group=x-node
# The Yggdrasil admin socket is root:yggdrasil 0660; the supervisor adds and
# removes public peers through it, so the service needs that group.
SupplementaryGroups=yggdrasil
ExecStart=/usr/local/bin/x-node serve -config /etc/x-node/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# The daemon only reads its config, writes its state and talks to the
# Yggdrasil admin socket. It never needs root: the sockets are bound to the
# Yggdrasil address, not to a privileged port.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/x-node
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
